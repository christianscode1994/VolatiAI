{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volatiai.dev/schemas/pair.schema.json",
  "title": "VolatiAI Correlation Pair",
  "type": "object",
  "required": ["a", "b", "r", "n"],
  "properties": {
    "a":              { "type": "string", "description": "First sector name" },
    "b":              { "type": "string", "description": "Second sector name" },
    "r":              { "type": "number", "minimum": -1, "maximum": 1 },
    "n":              { "type": "integer", "minimum": 3 },
    "abs_r":          { "type": "number", "minimum": 0, "maximum": 1 },
    "p_value":        { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "p_bh":           { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "bh_significant": { "type": ["boolean", "null"] },
    "perm_p":         { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "ci_low":         { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
    "ci_high":        { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
    "ci_width":       { "type": ["number", "null"], "minimum": 0, "maximum": 2 },
    "provenance":     { "type": ["boolean", "null"] },
    "same_metric_name": { "type": ["boolean", "null"] },
    "stale_data":     { "type": ["boolean", "null"] },
    "verdict": {
      "type": ["string", "null"],
      "enum": [null, "confirm:provenance", "surface", "dispute:provenance",
               "suppress:multiple_testing", "suppress:noisy",
               "suppress:too_short", "suppress:weak", "suppress:stale_data"]
    },
    "tier":      { "type": ["string", "null"], "enum": [null, "P", "A", "B", "C", "D"] },
    "reliability": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "contradiction": {
      "type": ["object", "null"],
      "properties": {
        "prior":     { "type": "string" },
        "observed":  { "type": "number" },
        "gap":       { "type": "number" }
      }
    },
    "warning": { "type": ["string", "null"] }
  }
}
