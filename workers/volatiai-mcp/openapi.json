    "/agentic-economy": {
      "get": {
        "summary": "Public read-only data on the x402 agent economy",
        "description": "Publishes aggregate raw counters about the x402 agent economy: Agent402's public tool-call counters and the live USDC balance at Agent402's payTo wallet on Base. Read-only publisher of public facts. Does not republish Agent402's derived estimates, top-tool rankings, or recent-calls selection. No auth, no accounts, no payments, no state. Not a benchmark. Not affiliated with Agent402.",
        "responses": {
          "200": {
            "description": "Aggregate public data about the agentic payment economy"
          },
          "502": {
            "description": "Upstream fetch error"
          }
        }
      }
    },
