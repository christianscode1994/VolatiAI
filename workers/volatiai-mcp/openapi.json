{
  "openapi": "3.1.0",
  "info": {
    "title": "VolatiAI MCP",
    "version": "1.0.0",
    "description": "Signed, verifiable monitoring of 421 public data sources. Every response carries an Ed25519 attestation verifiable offline. This service provides descriptive change detection and summaries, not predictive signals. See /track-record for backtest evidence.",
    "x-guidance": "VolatiAI returns signals about 421 sectors (crypto, finance, weather, science, security) with an Ed25519 signature. Each result includes the payload, the signature, and the pubkey ID needed to verify it. To verify offline: fetch the pubkey at /.well-known/volatiai-pubkey.pem, canonicalize the payload (sorted keys, no whitespace), and check the signature with Ed25519. Do not trust the data without verification. Free tier is unauthenticated.",
    "contact": {
      "email": "contact@fourieranalys.se",
      "url": "https://christianscode1994.github.io/VolatiAI/"
    }
  },
  "externalDocs": {
    "url": "https://christianscode1994.github.io/VolatiAI/",
    "description": "Verification guide, key rotation history, and public key registry"
  },
  "servers": [
    {
      "url": "https://volatiai-mcp.fourieranalys.workers.dev"
    }
  ],
  "paths": {
    "/mcp": {
      "post": {
        "summary": "Call a VolatiAI MCP tool (free tier)",
        "description": "JSON-RPC 2.0 endpoint exposing 11 tools. Free, unauthenticated.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "method"
                ],
                "properties": {
                  "jsonrpc": {
                    "type": "string",
                    "const": "2.0"
                  },
                  "id": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "tools/list",
                      "tools/call"
                    ],
                    "description": "MCP method to invoke"
                  },
                  "params": {
                    "type": "object",
                    "description": "For tools/call: { name, arguments }"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC result"
          }
        },
        "security": []
      }
    },
    "/premium/mcp": {
      "post": {
        "summary": "Call a VolatiAI MCP tool (premium, x402)",
        "description": "Same 13 tools as /mcp, priced at $0.005 USDC per call via x402. Returns 402 with payment requirements; retry with X-PAYMENT header (base64-encoded EIP-712 TransferWithAuthorization).",
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.005"
          },
          "networks": [
            "eip155:5042",
            "eip155:8453"
          ],
          "description": "$0.005 per request, settled in USDC on Arc or Base",
          "protocols": [
            {
              "x402": {}
            }
          ],
          "accepts": [
            {
              "scheme": "exact",
              "network": "eip155:5042",
              "maxAmountRequired": "5000",
              "amount": "5000",
              "resource": "https://volatiai-mcp.fourieranalys.workers.dev/premium/mcp",
              "description": "VolatiAI premium signals \u2014 $0.005 per request, USDC on Arc",
              "mimeType": "application/json",
              "payTo": "0x3EE508f75342315164301B2282f302DF3d3beD47",
              "maxTimeoutSeconds": 60,
              "asset": "0x3600000000000000000000000000000000000000",
              "extra": {
                "name": "USDC",
                "version": "2"
              }
            },
            {
              "scheme": "exact",
              "network": "eip155:8453",
              "maxAmountRequired": "5000",
              "amount": "5000",
              "resource": "https://volatiai-mcp.fourieranalys.workers.dev/premium/mcp",
              "description": "VolatiAI premium signals \u2014 $0.005 per request, USDC on Base",
              "mimeType": "application/json",
              "payTo": "0x3EE508f75342315164301B2282f302DF3d3beD47",
              "maxTimeoutSeconds": 60,
              "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
              "extra": {
                "name": "USD Coin",
                "version": "2"
              }
            }
          ]
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "method"
                ],
                "properties": {
                  "jsonrpc": {
                    "type": "string",
                    "const": "2.0"
                  },
                  "id": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "method": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC result, payment settled"
          },
          "402": {
            "description": "Payment required",
            "headers": {
              "PAYMENT-REQUIRED": {
                "schema": {
                  "type": "string"
                },
                "description": "Base64-encoded x402 PaymentRequired object"
              }
            }
          }
        },
        "security": [
          {
            "x402": []
          }
        ]
      }
    },
    "/premium/list_active_signals": {
      "post": {
        "summary": "Monitor crypto volatility changes and active sector signals",
        "description": "Monitor ongoing signals across 421 public data sources: crypto, security, markets, health, governance. Use when an agent needs to monitor changes, watch for crypto volatility shifts, detect sector events, or list recent monitored changes. Returns signed signal objects with sector, severity, magnitude, delta, window, and Ed25519 attestation. Deterministic, no LLM.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 25
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "info",
                      "notice",
                      "warning",
                      "alert",
                      "critical"
                    ]
                  },
                  "category": {
                    "type": "string",
                    "description": "Security, Crypto, Environment, Tech, Markets, Health, Governance, or Other"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result + Ed25519 receipt"
          },
          "402": {
            "description": "Payment required \u2014 USDC on Base"
          }
        },
        "x-price": "5000",
        "x-network": "eip155:8453",
        "x-asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
        "x-payTo": "0x3EE508f75342315164301B2282f302DF3d3beD47"
      }
    },
