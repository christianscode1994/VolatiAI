#!/bin/bash
# Pre-commit: safety gate + junk guard + sector/license/YAML audits.
set -e

# ─── JUNK GUARD (fast, first) ───
BLOCK='(^|/)(node_modules|\.wrangler|private)/|\.bak(\.|$)|\.local$|^\.signal-notify-state\.json$'
HITS=$(git diff --cached --name-only | grep -E "$BLOCK" || true)
if [ -n "$HITS" ]; then
    echo "✗ pre-commit: refusing to commit generated/sensitive files:" >&2
    echo "$HITS" | sed 's/^/  /' >&2
    echo "Fix .gitignore, or use 'git commit --no-verify' if intentional." >&2
    exit 1
fi

# ─── UNKNOWN SECTOR GUARD ───
bash scripts/check_unknown.sh || exit 1

# ─── SAFETY GATE (syntax + JSON + duplicate/empty collectors) ───
echo "→ Safety gate..."
set +e
bad=0
for f in workers/*/src/index.js; do
  node --check "$f" >/dev/null 2>&1 || { echo "✗ SYNTAX: $f"; bad=1; }
  d=$(awk '/^const COLLECTORS = [{]/{a=1} a&&/^};/{exit} a' "$f" | grep -oE '^  "[a-z][a-z0-9-]+": [{]$' | sort | uniq -d)
  [ -z "$d" ] || { echo "✗ DUPLICATE COLLECTORS in $f:"; echo "$d"; bad=1; }
  e=$(python3 -c '
import re, sys
src = open(sys.argv[1]).read()
m = re.search(r"^const COLLECTORS = \{\s*\n(.*?)^\};", src, re.M | re.S)
if not m: sys.exit(0)
body = m.group(1)
for bm in re.finditer(r"^  \"([a-z][a-z0-9-]+)\": \{\n(.*?)\n  \},", body, re.M | re.S):
    name, block = bm.group(1), bm.group(2)
    if "collectAll" in block and not any(k in block for k in ("fetch(", "value:", "await ")):
        print(name)
' "$f")
  [ -z "$e" ] || { echo "✗ EMPTY COLLECTOR in $f:"; echo "$e"; bad=1; }
done
for f in config/*.json docs/*.json; do
  [ -f "$f" ] || continue
  [ -s "$f" ] || { echo "✗ EMPTY JSON: $f"; bad=1; continue; }
  python3 -c "import json,sys;json.load(open(sys.argv[1]))" "$f" 2>/dev/null || { echo "✗ INVALID JSON: $f"; bad=1; }
done
set -e
[ "$bad" = "0" ] || { echo "✗ Safety gate failed"; exit 1; }
echo "✓ Safety gate passed"

# ─── DOMAIN AUDITS ───
echo "→ Domain audits..."
python3 scripts/audit_sectors.py
python3 scripts/audit_licenses.py

for yaml_file in .github/workflows/*.yml; do
  python3 -c "import yaml; yaml.safe_load(open('$yaml_file'))" 2>/dev/null || {
    echo "✗ YAML parse error in $yaml_file"
    python3 -c "import yaml; yaml.safe_load(open('$yaml_file'))" 2>&1 | tail -3
    exit 1
  }
done

# ─── TEST SUITES ───
# Runs the test files themselves, not just the code they test. Closes the
# class where a test file ships broken while every other check reports
# green: ec6f1826 had a SyntaxError in test-all.py, and 'All pre-commit
# checks passed' was truthful about its own scope and misleading about
# the file.
echo "→ Test suites..."

# test-all.py — AST parse + execution.
if [ -f scripts/test-all.py ]; then
  python3 -c "import ast; ast.parse(open('scripts/test-all.py').read())" || {
    echo "✗ test-all.py syntax error — refusing commit" >&2
    python3 -c "import ast; ast.parse(open('scripts/test-all.py').read())" 2>&1 | tail -3 >&2
    exit 1
  }
  if ! python3 scripts/test-all.py >/tmp/test-all.out 2>&1; then
    echo "✗ test-all.py failing — refusing commit" >&2
    tail -25 /tmp/test-all.out >&2
    exit 1
  fi
  n=$(grep -c '✅' /tmp/test-all.out || echo '?')
  echo "  ✓ test-all.py ($n assertions)"
fi

# verify.cjs — parse gate. Catches broken .cjs before push.
if [ -f scripts/verify.cjs ]; then
  node --check scripts/verify.cjs || {
    echo "✗ verify.cjs syntax error — refusing commit" >&2
    exit 1
  }
  echo "  ✓ verify.cjs parses"
fi

# test-verify-offline.sh — full verifier smoke, all layered negatives.
# If verify.cjs stops rejecting a tampered payload at the right layer,
# this fires before commit.
if [ -f scripts/test-verify-offline.sh ]; then
  if ! bash scripts/test-verify-offline.sh >/tmp/verifier-test.out 2>&1; then
    echo "✗ test-verify-offline.sh failing — refusing commit" >&2
    tail -30 /tmp/verifier-test.out >&2
    exit 1
  fi
  echo "  ✓ test-verify-offline.sh (layered negatives)"
fi

echo "✓ All pre-commit checks passed"
