#!/bin/bash
# Pre-commit hook — runs structural and compliance audits before every commit.
# Blocks the commit if either fails. Catches the exact class of bug that
# caused tonight's failed sector additions (wrong block insertion, missing
# active_sectors entry, restricted source leak).

set -e
# ─── SAFETY GATE (syntax + JSON validity + duplicate collectors + empty bodies) ───
echo "→ Running safety gate..."
set +e
bad=0
for f in workers/*/src/index.js; do
  node --check "$f" >/dev/null 2>&1 || { echo "✗ SYNTAX: $f"; bad=1; }
  d=$(awk '/^const COLLECTORS = [{]/{a=1} a&&/^};/{exit} a' "$f" | grep -oE '^  "[a-z][a-z0-9-]+": [{]$' | sort | uniq -d)
  [ -z "$d" ] || { echo "✗ DUPLICATE COLLECTORS in $f:"; echo "$d"; bad=1; }
  e=$(python3 -c '
import re, sys
src = open(sys.argv[1]).read()
m = re.search(r"^const COLLECTORS = \{\s*\n(.*?)^\};", src, re.M | re.S)
if not m: sys.exit(0)
body = m.group(1)
for bm in re.finditer(r"^  \"([a-z][a-z0-9-]+)\": \{\n(.*?)\n  \},", body, re.M | re.S):
    name, block = bm.group(1), bm.group(2)
    if "collectAll" in block and not any(k in block for k in ("fetch(", "value:", "await ")):
        print(name)
' "$f")
  [ -z "$e" ] || { echo "✗ EMPTY COLLECTOR in $f:"; echo "$e"; bad=1; }
done
for f in config/*.json docs/*.json; do
  [ -f "$f" ] || continue
  [ -s "$f" ] || { echo "✗ EMPTY JSON: $f"; bad=1; continue; }
  python3 -c "import json,sys;json.load(open(sys.argv[1]))" "$f" 2>/dev/null || { echo "✗ INVALID JSON: $f"; bad=1; }
done
set -e
[ "$bad" = "0" ] || { echo "✗ Safety gate failed — commit blocked"; exit 1; }
echo "✓ Safety gate passed"
# ─── END SAFETY GATE ───


echo "→ Running pre-commit audits..."

# Structural: every active sector has a Worker block, and vice versa
python3 scripts/audit_sectors.py

# Compliance: no restricted sources in Worker code
python3 scripts/audit_licenses.py

# YAML validity: broken workflow YAML causes GitHub to treat the
# file as having no triggers at all (workflow_dispatch disappears,
# runs fail at parse time). Ship this wrong and the workflow is
# dead until a manual fix. Not worth the risk — validate it.
for yaml_file in .github/workflows/*.yml; do
  python3 -c "import yaml; yaml.safe_load(open('$yaml_file'))" 2>/dev/null || {
    echo "✗ YAML parse error in $yaml_file"
    python3 -c "import yaml; yaml.safe_load(open('$yaml_file'))" 2>&1 | tail -3
    exit 1
  }
done

echo "✓ Pre-commit audits passed"
