const SECTOR = "{{SECTOR}}";

function envelope({ has_signal, severity, summary, delta, context, sources }) {
  return new Response(JSON.stringify({
    sector: SECTOR,
    has_signal,
    density: "{{DENSITY}}",
    severity: has_signal ? severity : "info",
    confidence: sources.healthy / Math.max(sources.total, 1),
    timestamp: new Date().toISOString(),
    summary: has_signal ? summary : "quiet",
    delta: delta || { metric: "none", current: 0, previous: null, pct_change: null, window: "{{WINDOW}}" },
    context: context || {},
    sources,
    ttl_seconds: {{TTL}},
  }), { headers: { "content-type": "application/json" } });
}

async function fetchSafe(fn) {
  try { return { ok: true, data: await fn() }; }
  catch (e) { return { ok: false, error: String(e).slice(0, 120) }; }
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    if (url.pathname === "/health") {
      return new Response(JSON.stringify({ ok: true, sector: SECTOR }), {
        headers: { "content-type": "application/json" },
      });
    }
    if (url.pathname === "/raw") {
      const raw = await collectAll(env);
      return new Response(JSON.stringify(raw, null, 2), {
        headers: { "content-type": "application/json" },
      });
    }
    if (url.pathname !== "/signal" && url.pathname !== "/") {
      return new Response("not found", { status: 404 });
    }

    const result = await collectAll(env);
    const healthy = Object.values(result.sources).filter(s => s.ok).length;
    const total = Object.keys(result.sources).length;

    if (healthy === 0) {
      return envelope({
        has_signal: false,
        sources: { total, healthy, failed: Object.keys(result.sources) },
      });
    }

    const metric = result.sources["{{METRIC}}"] && result.sources["{{METRIC}}"].ok
      ? result.sources["{{METRIC}}"].data
      : null;
    let prevStr = null;
    let absChange = 0;
    let pct = 0;
    if (metric !== null) {
      prevStr = await env.SECTOR_KV.get("{{SECTOR}}_{{METRIC}}");
      if (prevStr) {
        const prevNum = parseFloat(prevStr);
        absChange = metric - prevNum;
        pct = prevNum === 0 ? 0 : (absChange / prevNum) * 100;
      }
      await env.SECTOR_KV.put("{{SECTOR}}_{{METRIC}}", String(metric), { expirationTtl: {{TTL}} });
    }

    const hasSignal = Math.abs(pct) >= {{THRESHOLD_PCT}} && Math.abs(absChange) >= {{THRESHOLD_ABS}};
    const sev = Math.abs(pct) >= ({{THRESHOLD_PCT}} * 3) ? "alert" : "notice";

    return envelope({
      has_signal: hasSignal,
      severity: sev,
      summary: hasSignal
        ? "{{METRIC}} " + metric + " (" + (pct > 0 ? "+" : "") + pct.toFixed(1) + "%)"
        : "quiet",
      delta: metric !== null
        ? { metric: "{{METRIC}}", current: metric, previous: prevStr ? parseFloat(prevStr) : null, pct_change: pct, window: "{{WINDOW}}" }
        : null,
      context: {
        {{CONTEXT}}
      },
      sources: {
        total, healthy,
        failed: Object.entries(result.sources).filter(([, v]) => !v.ok).map(([k]) => k),
      },
    });
  },
};

async function collectAll(env) {
  return {
    sources: {
      {{COLLECTORS}}
    },
  };
}
