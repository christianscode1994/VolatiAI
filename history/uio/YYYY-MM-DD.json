const RAW_HISTORY =
  "https://raw.githubusercontent.com/christianscode1994/VolatiAI/main/history/uio/";

async function loadTrend() {
  const days = 7; // last 7 days
  const trend = [];

  for (let i = 0; i < days; i++) {
    const d = new Date(Date.now() - i * 86400000);
    const iso = d.toISOString().slice(0, 10);
    const url = `${RAW_HISTORY}${iso}.json`;

    try {
      const res = await fetch(url);
      if (res.ok) {
        const snapshot = await res.json();
        trend.push({ date: iso, snapshot });
      }
    } catch {}
  }

  console.log("Trend Data:", trend);
  return trend;
}
const trend = await loadTrend();

new Chart(document.getElementById("trendChart"), {
  type: "line",
  data: {
    labels: trend.map(t => t.date),
    datasets: [
      {
        label: "Global Risk Trend",
        data: trend.map(t => t.snapshot.risk.global),
        borderColor: "#4a6cf7",
        fill: false
      }
    ]
  }
});
